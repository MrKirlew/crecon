# ==================== AI Executive Assistant Environment Configuration ====================
# Copy this file to .env and fill in your actual values
# SECURITY: Never commit the .env file to version control

# ==================== PostgreSQL Database Configuration ====================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ==================== N8N Workflow Engine Configuration ====================
# N8N Host Configuration
N8N_HOST=your-domain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-domain.com/webhook

# N8N Basic Authentication (for accessing N8N UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# N8N Webhook Secret (CRITICAL: Must match FastAPI configuration)
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Timezone
TIMEZONE=America/New_York

# ==================== LLM API Keys ====================
# OpenAI (GPT-4, GPT-4o-mini)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
GOOGLE_API_KEY=...

# ==================== LLM Model Configuration ====================
# Default model for routine tasks (cost-optimized)
DEFAULT_LLM_MODEL=gpt-4o-mini

# Premium model for complex reasoning (model routing)
PREMIUM_LLM_MODEL=gpt-4

# ==================== Token Budget and Cost Control ====================
# Maximum tokens per request (prevents runaway costs)
MAX_TOKENS_PER_REQUEST=8000

# Warning threshold for token usage
TOKEN_BUDGET_WARNING_THRESHOLD=6000

# ==================== Qdrant Vector Database Configuration ====================
QDRANT_COLLECTION_NAME=executive_knowledge

# ==================== N8N Webhook Integration ====================
N8N_WEBHOOK_URL=http://n8n:5678/webhook

# ==================== Redis Cache Configuration (Optional) ====================
REDIS_HOST=redis
REDIS_PORT=6379
ENABLE_CACHE=false

# ==================== Langfuse Observability (Optional) ====================
# Leave empty to disable observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Langfuse Database Configuration (if using observability)
LANGFUSE_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
# Generate with: openssl rand -hex 32
LANGFUSE_SALT=

# ==================== SSL/TLS Configuration ====================
# Path to SSL certificates (for production deployment)
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/cert.pem
SSL_CERTIFICATE_KEY_PATH=/etc/nginx/ssl/key.pem

# ==================== Google OAuth Credentials (for N8N integrations) ====================
# Configure these in N8N UI after deployment
# Required for Google Calendar, Gmail, Drive, Contacts, Sheets integrations
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/rest/oauth2-credential/callback
